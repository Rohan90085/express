<!DOCTYPE html>
<html>
<head>
    <title>User Page</title>
</head>
<body>

    <h1>Add New User</h1>

    <form action="/user/add" method="POST">
        <label>Name:</label>
        <input type="text" name="name" required />
        <br><br>

        <label>Email:</label>
        <input type="email" name="email" required />
        <br><br>

        <button type="submit">Add User</button>
    </form>

    <hr>

    <h2>User List</h2>
    <ul>
        <% users.forEach(user => { %>
            <li><%= user.name %> - <%= user.email %></li>
        <% }) %>
    </ul>

</body>
</html>
