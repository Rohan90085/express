<!DOCTYPE html>
<html>
<head>
    <title>User Page</title>
</head>
<body>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            background-color: black;
            color: rgb(129, 125, 125);
        }
        input, button {
            padding: 10px;
            margin: 5px 0;
            border: none;
            border-radius: 5px;
        }
        .a1{
            display: flex;
            justify-content: center;
        }
    </style>

<div class="a1">
<div class="a2">
    <h1>Add New User</h1>

    <form action="/user/add" method="POST">
        <label>Name:</label>
        <input type="text" name="name" required />
        <br><br>

        <label>Email:</label>
        <input type="email" name="email" required />
        <br><br>

        <button type="submit" style="margin-left:55px">Add User</button>
    </form>

    </div>
<div class="a3">
    <h2>User List</h2>
    <ul>
        <% users.forEach(user => { %>
            <li><%= user.name %> - <%= user.email %></li>
        <% }) %>
    </ul>
    </div>
</div>
<hr>

</body>
</html>
